APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# MongoDB Atlas (recommended)
DB_CONNECTION=mongodb
DB_URI="mongodb+srv://<username>:<password>@<cluster>/<optional-db>?retryWrites=true&w=majority"
DB_DATABASE="MSME"

# Recommended defaults for MongoDB setup
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Email (OTP verification)
# Local testing: keep `log` and check `backend/storage/logs/laravel.log`
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ImageKit (file uploads)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/msme

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
